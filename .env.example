# Copia este archivo como .env (no se sube al repositorio).
NODE_ENV=development
PORT=3000
# Origen del sitio público y del panel (en producción: https://DOMINIO_PUBLICO y https://SUBDOMINIO_ADMIN)
PUBLIC_ORIGIN=http://localhost:5173
# ADMIN_ORIGIN admite varios separados por coma (p. ej. http://localhost:5174,https://xxxx.trycloudflare.com)
ADMIN_ORIGIN=http://localhost:5174
# Base de datos SQLite (ruta del archivo)
DATABASE_URL=file:./.data/pato.db
# 64 caracteres aleatorios
SESSION_SECRET=cambia-esto-por-64-caracteres-aleatorios-cambia-esto-por-64-caracteres
MEDIA_DIR=./.data/medios
MEDIA_BASE_URL=/medios
TZ_NEGOCIO=America/Bogota
# IP real del visitante cuando hay un proxy delante: cf-connecting-ip (Cloudflare) o x-real-ip (nginx). Vacío = IP de la conexión.
IP_CABECERA=
# Límites de peticiones por minuto, por IP
RATE_LIMIT_RESERVAS=10
RATE_LIMIT_GIRO=5
RATE_LIMIT_CONTACTOS=20
RATE_LIMIT_MIS_NUMEROS=10
RATE_LIMIT_LECTURAS=120
# Solo desarrollo: contraseña del administrador que crea "npm run semilla"
SEMILLA_ADMIN_USUARIO=miguel
SEMILLA_ADMIN_CLAVE=
